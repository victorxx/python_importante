import easyocr

produtos = ["sonho de valsa", "chocolate garoto", "bis", "oreo"]

arquivo = r"C:\Users\xxvitaoxx\Downloads\7622210575975_1.jpg"

ler = easyocr.Reader(["pt"])

resultado = ler.readtext(arquivo)

for item in resultado:
    texto = item[1].lower()
    print("Texto:", texto)

    for produto in produtos:
        if produto in texto:
            print("Produto existe sim:", produto)
